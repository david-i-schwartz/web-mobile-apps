{
  "name": "FIG: Fusebead Image Generator",
  "short_name": "FIG",
  "description": "Turn an image into a bead pattern on square, hex or iso pegboards. Isolate a colour, tap beads off as you place them, and work one chunk at a time. Progress is saved in this browser. You can also edit the pattern by hand, in layers if you like, design one on an empty board, keep several patterns, and print a chart for each board, at true size if you like.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F3F5F8",
  "theme_color": "#0E7C7B",
